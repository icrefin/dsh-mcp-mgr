{
  "name": "dsh-mcp-mgr",
  "version": "1.0.0",
  "description": "Workspace-level MCP server manager for DeepSeek Harness: a profile-scoped server registry with per-workspace selection, managed from a left-sidebar panel through a Typert Remote",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "mcp",
    "model-context-protocol",
    "mcp-client",
    "mcp-manager",
    "mcp-mgr"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/types/typert.host.d.ts",
      "default": "./lib/types/typert.host.js"
    },
    "./remote": {
      "types": "./lib/types/typert.remote-client.d.ts",
      "default": "./lib/types/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:host",
    "build:host": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "node tools/verify-typert.mjs",
    "pack": "pnpm build && pnpm pack --pack-destination dist",
    "check": "pnpm typecheck && pnpm build && pnpm verify"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || ^4.0.2",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.20.0",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2"
  }
}
