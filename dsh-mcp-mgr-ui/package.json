{
  "name": "dsh-mcp-mgr-ui",
  "description": "Browser half of dsh-mcp-mgr: the MCP server management panel in the dsh sidebar",
  "version": "1.0.1",
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/client.js",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "dsh-mcp-mgr": "workspace:*",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.3",
    "@deepseek-ai/cordis": ">=4.0.5",
    "react": "^18.2.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "unrun": "^0.3.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -p tsconfig.build.json",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "verify": "node tools/verify-client.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm verify",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\""
  }
}
